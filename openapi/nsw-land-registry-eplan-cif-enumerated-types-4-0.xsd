			<xs:enumeration value="Tasmania"/>
			<xs:enumeration value="Western Australia"/>
			<xs:enumeration value="Victoria"/>-->
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="monumentCondition">
		<xs:annotation>
			<xs:documentation>This gives a general indication of the condition of the monument</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="Destroyed"/>
			<xs:enumeration value="Not Found"/>
			<xs:enumeration value="Uncertain"/>
			<xs:enumeration value="Subsidence Area"/>
			<xs:enumeration value="Found Intact"/>
			<xs:enumeration value="Restricted Access"/>
		</xs:restriction>
	</xs:simpleType>
