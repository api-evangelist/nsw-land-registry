<xs:schema xmlns="urn:xml-gov-au:nsw:icsm:eplan:cif:enumerated-types:4.0" xmlns:xs="http://www.w3.org/2001/XMLSchema" targetNamespace="urn:xml-gov-au:nsw:icsm:eplan:cif:enumerated-types:4.0" elementFormDefault="qualified" attributeFormDefault="unqualified" version="4.0">
	<xs:simpleType name="addressPointTypeType">
		<xs:annotation>
			<xs:documentation>This is a string to define the type of Geocode that the address point is for example,centroid of parcel, Access Point etc.  This will be a jurisdictionally based list.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="Access Point"/>
			<xs:enumeration value="Centroid of Parcel"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="addressTypeType">
		<xs:annotation>
			<xs:documentation>This Type is to define a jurisdictional specific list of address types such a primary address, alias, secondary, historical etc.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="Alias"/>
			<xs:enumeration value="Historical"/>
			<xs:enumeration value="Primary"/>
			<xs:enumeration value="Secondary"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="adminAreaTypeType">
		<xs:annotation>
			<xs:documentation>This is a jurdictionally specific list of types and may include parish, town, local government, locality etc</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="County"/>
			<xs:enumeration value="Locality"/>
			<xs:enumeration value="Local Government Area"/>
			<xs:enumeration value="Parish"/>
			<xs:enumeration value="Survey Region"/>
			<xs:enumeration value="Terrain"/>
			<xs:enumeration value="Misclose Accuracy"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="adminDateTypeType">
		<xs:annotation>
			<xs:documentation>This is a jurdictionally specific list of date types and may include dates such as Image dates, registraion dates, valuation dates, building approval dates etc  </xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="Date Of Survey"/>
			<xs:enumeration value="Date Of Compilation"/>
			<xs:enumeration value="Date Of Survey Certificate"/>
			<xs:enumeration value="Date Of Subdivision Certificate"/>
			<xs:enumeration value="Date Of Strata Certificate"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="annotationType">
		<xs:annotation>
			<xs:documentation>An Annotation will be a specific type within a jurisdiction. </xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="Parcel Note"/>
			<xs:enumeration value="Plan Note"/>
			<xs:enumeration value="Plans Used"/>
			<xs:enumeration value="Subdivision Number"/>
			<xs:enumeration value="Diagram"/>
			<xs:enumeration value="Diagram Lots"/>
			<xs:enumeration value="Diagram Occupations"/>
			<xs:enumeration value="Diagram Secondary Interests"/>
			<xs:enumeration value="Direction Of Flow Tidal"/>
			<xs:enumeration value="Direction Of Flow Non Tidal"/>
			<xs:enumeration value="Combined Scale Factor"/>
			<xs:enumeration value="LRS File Ref"/>
			<xs:enumeration value="Scale"/>
			<!--<xs:enumeration value="AffectedCT"/>-->
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="documentStatusType">
		<xs:annotation>
			<xs:documentation>This field identifes the legal status for this document, for example it is the leagal record of survey, if was data captured from historical data etc.  This is used to determine processing of the record</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="Data captured"/>
			<xs:enumeration value="Final lodgement"/>
			<xs:enumeration value="Historical"/>
			<xs:enumeration value="Preliminary Examination"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="equipmentType">
		<xs:annotation>
			<xs:documentation>This is a rough indication of the type of equipment</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="GNSS"/>
			<xs:enumeration value="Scale"/>
			<xs:enumeration value="Total station"/>
			<xs:enumeration value="Theodolite"/>
			<xs:enumeration value="Unknown"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="exclusType">
		<xs:annotation>
			<xs:documentation>This is a jurisdictionally based list of exclusions for a Title example would be exclusions for Road, Track, Esplanarde etc </xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="Land Designated "/>
			<xs:enumeration value="Other Lots"/>
			<xs:enumeration value="River"/>
			<xs:enumeration value="Road"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="flatTypeType">
		<xs:annotation>
			<xs:documentation>To define a Jurisdictional specific list of address living unit types for addressing</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="Apartment"/>
			<xs:enumeration value="Berth"/>
			<xs:enumeration value="Cottage"/>
			<xs:enumeration value="Dock"/>
			<xs:enumeration value="Duplex"/>
			<xs:enumeration value="Factory"/>
			<xs:enumeration value="Flat"/>
			<xs:enumeration value="House"/>
			<xs:enumeration value="Kiosk"/>
			<xs:enumeration value="Office"/>
			<xs:enumeration value="Penthouse"/>
			<xs:enumeration value="Premises"/>
			<xs:enumeration value="Room"/>
			<xs:enumeration value="Shed"/>
			<xs:enumeration value="Shop"/>
			<xs:enumeration value="Stall"/>
			<xs:enumeration value="Studio"/>
			<xs:enumeration value="Suite"/>
			<xs:enumeration value="Townhouse"/>
			<xs:enumeration value="Unit"/>
			<xs:enumeration value="Villa"/>
			<xs:enumeration value="Ward"/>
			<xs:enumeration value="Warehouse"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="floorLevelTypeType">
		<xs:annotation>
			<xs:documentation>To define a jurisdictionally specific list of floo level types for example, Lower Ground Floor</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="Basement"/>
			<xs:enumeration value="Floor"/>
			<xs:enumeration value="Ground"/>
			<xs:enumeration value="Level"/>
			<xs:enumeration value="Lobby"/>
			<xs:enumeration value="Lower Ground Floor"/>
			<xs:enumeration value="Lower Level"/>
			<xs:enumeration value="Mezzanine"/>
			<xs:enumeration value="Observation Deck"/>
			<xs:enumeration value="Parking"/>
			<xs:enumeration value="Platform"/>
			<xs:enumeration value="Podium"/>
			<xs:enumeration value="Rooftop"/>
			<xs:enumeration value="Sub-Basement"/>
			<xs:enumeration value="Upper Ground Floor"/>
		</xs:restriction>
	</xs:simpleType>
